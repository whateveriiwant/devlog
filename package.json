{
  "name": "seungjun-dev-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --force",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "astro build --force && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1",
    "collect": "python3 scripts/collect-velog.py",
    "analyze": "node scripts/analyze-content.mjs",
    "migrate": "node scripts/migrate-velog.mjs",
    "verify:migration": "node scripts/verify-migration.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:search": "node scripts/verify-search.mjs",
    "d1:export": "node scripts/export-d1-snapshot.mjs",
    "d1:verify": "node scripts/verify-d1-snapshot.mjs",
    "images:download": "node scripts/migrate-images.mjs download",
    "images:upload": "node scripts/migrate-images.mjs upload",
    "images:verify": "node scripts/migrate-images.mjs verify",
    "commit": "cz",
    "commit:push": "git add . && pnpm commit && git push",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/react": "6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "dompurify": "^3.4.16",
    "github-slugger": "^2.0.0",
    "hast-util-to-text": "^4.0.2",
    "lucide-react": "^1.45.0",
    "marked": "^18.0.14",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cheerio": "^1.2.0",
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.5.4",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hast-util-to-string": "^3.0.1",
    "husky": "^9.1.7",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "^4.141.0",
    "yaml": "^2.9.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  }
}
