{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "devlog",
  "main": "./worker/site.mjs",
  "compatibility_date": "2026-09-16",
  "vars": {
    "SITE_ORIGIN": "https://seungjun.sh",
    "CONTENT_READS": "false",
  },
  "services": [{ "binding": "CMS", "service": "devlog-cms" }],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/write",
      "/write/*",
      "/admin",
      "/admin/*",
      "/api/content/*",
      "/blog/*",
      "/series",
      "/series/*",
      "/tags",
      "/tags/*",
      "/rss.xml",
      "/sitemap.xml",
      "/sitemap-index.xml",
      "/article-template/*",
      "/collection-template/*",
      "/list-template/*",
    ],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "env": {
    "stage": {
      "name": "devlog-site-stage",
      "vars": {
        "SITE_ORIGIN": "https://devlog-site-stage.seungjun-jeong10.workers.dev",
        "CONTENT_READS": "true",
        "STAGE_EDITOR_PREVIEW": "true",
      },
      "services": [{ "binding": "CMS", "service": "devlog-cms-stage" }],
    },
  },
}
