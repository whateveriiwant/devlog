---
import Expandable from '../components/Expandable';
import ArticleBreadcrumb from '../components/ArticleBreadcrumb';
import SeriesPostPagination from '../components/SeriesPostPagination';
import { Badge } from '../components/ui/badge';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import {
  getContent,
  postUrl,
  seriesUrl,
  tagUrl,
  tagsFor,
  dateLabel,
  imageUrl,
  type Post,
} from '../lib/content';
interface Props {
  post: Post;
  headings: MarkdownHeading[];
}
const { post, headings } = Astro.props;
const { posts, series } = await getContent();
const group = series.find((s) => s.id === post.data.series?.id);
const position = group?.posts.findIndex((p) => p.id === post.id) ?? -1;
const adjacent = group?.posts || [...posts].reverse();
const idx = group ? position : adjacent.findIndex((p) => p.id === post.id);
const previous = group ? adjacent[idx + 1] : adjacent[idx - 1];
const next = group ? adjacent[idx - 1] : adjacent[idx + 1];
const mine = tagsFor(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  seriesId={group?.id}
  postId={post.id}
  publishedAt={post.data.publishedAt}
  image={imageUrl(post.data.thumbnail)}
>
  <article data-pagefind-body>
    <header class="article-heading">
      <div data-pagefind-ignore>
        <ArticleBreadcrumb
          series={
            group
              ? { name: group.data.name, href: seriesUrl(group.data.slug) }
              : undefined
          }
        />
      </div>
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      {post.data.description && (
        <p class="article-description" data-pagefind-meta="description">
          {post.data.description.replace(/[\u0000-\u001f]/g, '')}
        </p>
      )}
      <div class="article-meta">
        <time
          datetime={post.data.publishedAt.toISOString()}
          data-pagefind-meta="publishedAt[datetime]"
        >
          {dateLabel(post.data.publishedAt)}
        </time>
      </div>
      <div
        class="article-tags"
        data-tags={mine.join(' · ')}
        data-pagefind-meta="tags[data-tags]"
      >
        {mine.map((tag) => (
          <a
            href={tagUrl(tag)}
            data-tag={tag}
            data-pagefind-filter="tag[data-tag]"
          >
            <Badge variant="secondary">#{tag}</Badge>
          </a>
        ))}
      </div>
      {group && (
        <span hidden data-pagefind-meta="series" data-pagefind-filter="series">
          {group.data.name}
        </span>
      )}
    </header>
    {headings.length > 0 && (
      <div data-pagefind-ignore class="mb-8 xl:hidden">
        <Expandable title="이 글의 목차" client:load>
          <TableOfContents headings={headings} />
        </Expandable>
      </div>
    )}
    <div class="prose">
      <slot />
    </div>
    <footer data-pagefind-ignore>
      <div class="article-pagination">
        <div>
          {previous && (
            <a href={postUrl(previous)}>
              <span>← {group ? '시리즈 이전 글' : '이전 기록'}</span>
              <strong>{previous.data.title}</strong>
            </a>
          )}
        </div>
        <div class="text-right">
          {next && (
            <a href={postUrl(next)}>
              <span>{group ? '시리즈 다음 글' : '다음 기록'} →</span>
              <strong>{next.data.title}</strong>
            </a>
          )}
        </div>
      </div>
      {group && (
        <SeriesPostPagination
          name={group.data.name}
          posts={group.posts.map((item, index) => ({
            href: postUrl(item),
            title: item.data.title,
            date: dateLabel(item.data.publishedAt),
            position: index + 1,
            current: item.id === post.id,
          }))}
          initialPage={Math.max(0, Math.floor(position / 4))}
          client:load
        />
      )}
    </footer>
  </article>
  <div slot="right" class="desktop-toc">
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
