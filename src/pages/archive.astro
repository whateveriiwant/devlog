---
import Expandable from '../components/Expandable';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { dateKey, getContent } from '../lib/content';
const { years, posts } = await getContent();
---
<BaseLayout title="아카이브" description="연도와 월을 따라 모든 개발 기록을 찾아보세요.">
  <header class="page-heading"><p class="eyebrow">ALL THE WAY BACK</p><h1>아카이브</h1><p class="page-description">{years.at(-1)!.year}년부터 {years[0].year}년까지, {posts.length}개의 기록.</p></header>
  <nav aria-label="연도 바로가기" class="archive-years">{years.map(y => <a href={`#year-${y.year}`}><span>{y.year}</span><span class="count">{y.posts.length}</span></a>)}</nav>
  {years.map(({year, posts: yearPosts}) => <Expandable title={String(year)} count={yearPosts.length} defaultOpen className="archive-year" id={`year-${year}`} client:load>
    {[...new Set(yearPosts.map(p => dateKey(p.data.publishedAt).slice(5,7)))].map(month => <section class="archive-month"><h3 class="font-mono">{month}<span>월</span></h3><PostList posts={yearPosts.filter(p => dateKey(p.data.publishedAt).slice(5,7) === month)} compact /></section>)}
  </Expandable>)}
  <div slot="right"><h2 class="rail-heading mb-5">모든 연도</h2><div class="year-links">{years.map(y => <a href={`#year-${y.year}`}><span>{y.year}</span><span class="count">{y.posts.length} ↗</span></a>)}</div><p class="rail-note">연도 제목을 누르면 목록을 접고 펼칠 수 있습니다.</p></div>
</BaseLayout>
