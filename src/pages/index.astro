---
import { Badge } from '../components/ui/badge';
import { buttonVariants } from '../components/ui/button';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  dateLabel,
  getContent,
  imageUrl,
  postUrl,
  seriesUrl,
  tagUrl,
} from '../lib/content';
const content = await getContent();
const featured =
  content.posts.find((post) => post.data.thumbnail) ?? content.posts[0];
const featuredImage = imageUrl(featured.data.thumbnail);
const recentPosts = content.posts
  .filter((post) => post.id !== featured.id)
  .slice(0, 6);
const recentSeries = [...content.series]
  .sort(
    (a, b) =>
      Math.max(...b.posts.map((post) => post.data.publishedAt.valueOf())) -
      Math.max(...a.posts.map((post) => post.data.publishedAt.valueOf()))
  )
  .slice(0, 4)
  .map((series) => {
    const latestPost = [...series.posts].sort(
      (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
    )[0];
    return {
      ...series,
      latestImage: imageUrl(latestPost.data.thumbnail),
    };
  });
const popularTags = content.tags.slice(0, 18);
---

<BaseLayout title="메인 페이지">
  <div class="min-h-[calc(100dvh-3.5rem)]" aria-label="메인 페이지">
    <section
      data-home-feature
      class="overflow-hidden rounded-xl border bg-card text-card-foreground"
    >
      <div class="grid lg:grid-cols-2">
        <a
          href={postUrl(featured)}
          data-home-feature-link
          data-home-feature-image
          class="group relative block min-h-64 overflow-hidden bg-muted lg:min-h-[23rem]"
          aria-label={`${featured.data.title} 읽기`}
        >
          {featuredImage ? (
            <img
              src={featuredImage}
              alt=""
              class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <div class="absolute inset-0 bg-gradient-to-br from-muted to-secondary" />
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-black/25 to-transparent lg:bg-gradient-to-r lg:from-transparent lg:to-black/10" />
        </a>

        <div class="flex flex-col justify-center p-6 sm:p-8">
          <div class="mb-5 flex flex-wrap items-center gap-2">
            <Badge>추천 글</Badge>
          </div>

          <h1 class="text-3xl leading-tight font-semibold tracking-tight text-balance sm:text-4xl">
            <a
              href={postUrl(featured)}
              data-home-feature-link
              data-home-feature-title
              class="hover:underline hover:underline-offset-4"
            >
              {featured.data.title}
            </a>
          </h1>
          <p
            data-home-feature-description
            class="mt-4 max-w-2xl text-sm leading-7 text-muted-foreground sm:text-base"
          >
            {featured.data.description}
          </p>

          <time
            data-home-feature-date
            datetime={featured.data.publishedAt.toISOString()}
            class="mt-5 text-xs text-muted-foreground sm:text-sm"
          >
            {dateLabel(featured.data.publishedAt)}
          </time>

          {featured.data.tags.length > 0 && (
            <div data-home-feature-tags class="mt-4 flex flex-wrap gap-2">
              {featured.data.tags.slice(0, 4).map((tag) => (
                <Badge variant="outline">#{tag}</Badge>
              ))}
            </div>
          )}

          <a
            href={postUrl(featured)}
            data-home-feature-link
            class={`${buttonVariants({ variant: 'default' })} mt-6 w-fit`}
          >
            글 읽기
          </a>
        </div>
      </div>
    </section>

    <section class="mt-14 grid gap-12 xl:grid-cols-[minmax(0,1.5fr)_minmax(18rem,.5fr)] xl:gap-16">
      <div>
        <div class="flex items-end justify-between gap-4 border-b pb-4">
          <h2 class="text-2xl font-semibold tracking-tight">최근 업데이트</h2>
          <a
            href="/blog/"
            class="text-sm font-medium underline-offset-4 hover:underline"
          >
            모든 글
          </a>
        </div>
        <div data-home-posts class="border-b">
          <PostList posts={recentPosts} />
        </div>
      </div>

      <aside class="self-start border-y py-6 sm:py-7 xl:border-y-0 xl:border-l xl:py-0 xl:pl-8">
        <h2 class="text-xl font-semibold tracking-tight">기록 둘러보기</h2>
        <dl class="mt-5 grid grid-cols-3 divide-x border-y">
          <div class="px-3 py-4 first:pl-0">
            <dt class="text-xs text-muted-foreground">전체 글</dt>
            <dd
              data-home-count="posts"
              class="mt-1 text-2xl font-semibold tabular-nums"
            >
              {content.posts.length}
            </dd>
          </div>
          <div class="px-3 py-4">
            <dt class="text-xs text-muted-foreground">시리즈</dt>
            <dd
              data-home-count="series"
              class="mt-1 text-2xl font-semibold tabular-nums"
            >
              {content.series.length}
            </dd>
          </div>
          <div class="px-3 py-4 last:pr-0">
            <dt class="text-xs text-muted-foreground">키워드</dt>
            <dd
              data-home-count="tags"
              class="mt-1 text-2xl font-semibold tabular-nums"
            >
              {content.tags.length}
            </dd>
          </div>
        </dl>
        <a
          href="/series/"
          class="mt-5 inline-block text-sm font-medium underline-offset-4 hover:underline"
        >
          시리즈 탐색
        </a>
      </aside>
    </section>

    <section class="mt-24">
      <div class="mb-7 flex items-end justify-between gap-4">
        <h2 class="text-2xl font-semibold tracking-tight">
          최근 업데이트된 시리즈
        </h2>
        <a
          href="/series/"
          class="text-sm font-medium underline-offset-4 hover:underline"
        >
          모든 시리즈
        </a>
      </div>
      <div
        data-home-series
        class="grid gap-px overflow-hidden rounded-lg border bg-border sm:grid-cols-2 md:grid-cols-4"
      >
        {recentSeries.map((series) => (
          <a
            href={seriesUrl(series.data.slug)}
            class="group flex min-w-0 bg-card p-3 transition-colors hover:bg-accent/60 sm:flex-col sm:p-4"
          >
            <div class="h-24 w-28 shrink-0 overflow-hidden rounded-md bg-muted sm:aspect-video sm:h-auto sm:w-full">
              {series.latestImage ? (
                <img
                  src={series.latestImage}
                  alt=""
                  loading="lazy"
                  class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                />
              ) : (
                <div class="size-full bg-gradient-to-br from-muted to-secondary" />
              )}
            </div>
            <div class="min-w-0 flex-1 py-2 pl-4 sm:px-0 sm:pt-3 sm:pb-0">
              <h3 class="line-clamp-2 text-base font-semibold leading-6 sm:text-lg sm:leading-7">
                {series.data.name}
              </h3>
              <div class="mt-2 text-xs text-muted-foreground">
                <span>{series.posts.length}개의 글</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-24 grid gap-8 border-y py-8 sm:py-10 lg:grid-cols-[18rem_minmax(0,1fr)]">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">많이 다룬 키워드</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">
          작성한 글의 수를 기준으로 자주 등장한 주제를 모았습니다.
        </p>
      </div>
      <div data-home-tags class="flex content-start flex-wrap gap-2">
        {popularTags.map((tag) => (
          <a href={tagUrl(tag.name)}>
            <Badge
              variant="outline"
              className="bg-background px-3 py-1.5 text-sm hover:bg-accent"
            >
              #{tag.name}{' '}
              <span class="ml-1 text-muted-foreground">{tag.posts.length}</span>
            </Badge>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
