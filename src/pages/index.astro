---
import { ArrowRight, ArrowUpRight, CalendarDays, Clock3, Library, Tags } from 'lucide-react';
import { Badge } from '../components/ui/badge';
import { buttonVariants } from '../components/ui/button';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { dateLabel, getContent, imageUrl, postUrl, readMinutes, seriesUrl, tagUrl } from '../lib/content';
const content = await getContent();
const featured = content.posts.find(post => post.data.thumbnail) ?? content.posts[0];
const featuredCategory = content.categories.find(category => category.id === featured.data.category);
const featuredImage = imageUrl(featured.data.thumbnail);
const recentPosts = content.posts.filter(post => post.id !== featured.id).slice(0, 6);
const featuredSeries = [...content.series].sort((a, b) => b.posts.length - a.posts.length).slice(0, 4);
const popularTags = content.tags.slice(0, 18);
---
<BaseLayout title="seungjun.dev">
  <div class="min-h-[calc(100dvh-3.5rem)]" aria-label="메인 페이지">
    <section class="overflow-hidden rounded-xl border bg-card text-card-foreground shadow-sm">
      <div class="grid lg:grid-cols-[minmax(0,1.15fr)_minmax(22rem,.85fr)]">
        <a href={postUrl(featured)} class="group relative block min-h-64 overflow-hidden bg-muted lg:min-h-[30rem]" aria-label={`${featured.data.title} 읽기`}>
          {featuredImage
            ? <img src={featuredImage} alt="" class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" loading="eager" fetchpriority="high" />
            : <div class="absolute inset-0 bg-gradient-to-br from-muted to-secondary" />}
          <div class="absolute inset-0 bg-gradient-to-t from-black/25 to-transparent lg:bg-gradient-to-r lg:from-transparent lg:to-black/10" />
        </a>

        <div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10 xl:p-12">
          <div class="mb-6 flex flex-wrap items-center gap-2">
            <Badge>추천 글</Badge>
            {featuredCategory && <Badge variant="secondary">{featuredCategory.name}</Badge>}
          </div>

          <h1 class="text-3xl leading-tight font-semibold tracking-tight text-balance sm:text-4xl xl:text-5xl">
            <a href={postUrl(featured)} class="hover:underline hover:underline-offset-4">{featured.data.title}</a>
          </h1>
          <p class="mt-5 max-w-2xl text-sm leading-7 text-muted-foreground sm:text-base">{featured.data.description}</p>

          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-muted-foreground sm:text-sm">
            <span class="inline-flex items-center gap-2"><CalendarDays className="size-4" />{dateLabel(featured.data.publishedAt)}</span>
            <span class="inline-flex items-center gap-2"><Clock3 className="size-4" />약 {readMinutes(featured)}분</span>
          </div>

          {featured.data.tags.length > 0 && <div class="mt-5 flex flex-wrap gap-2">{featured.data.tags.slice(0, 4).map(tag => <Badge variant="outline">#{tag}</Badge>)}</div>}

          <a href={postUrl(featured)} class={`${buttonVariants({ variant: 'default' })} mt-8 w-fit`}>
            글 읽기 <ArrowRight className="size-4" />
          </a>
        </div>
      </div>
    </section>

    <section class="mt-20 grid gap-12 xl:grid-cols-[minmax(0,1.5fr)_minmax(18rem,.5fr)] xl:gap-16">
      <div>
        <div class="flex items-end justify-between gap-4 border-b pb-4">
          <div>
            <p class="mb-2 text-xs font-medium tracking-widest text-muted-foreground">RECENTLY UPDATED</p>
            <h2 class="text-2xl font-semibold tracking-tight">최근 업데이트</h2>
          </div>
          <a href="/blog/" class={buttonVariants({ variant: 'ghost', size: 'sm' })}>모든 글 <ArrowRight className="size-4" /></a>
        </div>
        <PostList posts={recentPosts} />
      </div>

      <aside class="self-start rounded-xl border bg-muted/25 p-6 sm:p-7">
        <p class="text-xs font-medium tracking-widest text-muted-foreground">AT A GLANCE</p>
        <h2 class="mt-2 text-xl font-semibold tracking-tight">기록 둘러보기</h2>
        <dl class="mt-7 grid grid-cols-3 gap-3 xl:grid-cols-1">
          <div class="rounded-lg border bg-background p-4"><dt class="text-xs text-muted-foreground">전체 글</dt><dd class="mt-1 text-2xl font-semibold tabular-nums">{content.posts.length}</dd></div>
          <div class="rounded-lg border bg-background p-4"><dt class="text-xs text-muted-foreground">시리즈</dt><dd class="mt-1 text-2xl font-semibold tabular-nums">{content.series.length}</dd></div>
          <div class="rounded-lg border bg-background p-4"><dt class="text-xs text-muted-foreground">키워드</dt><dd class="mt-1 text-2xl font-semibold tabular-nums">{content.tags.length}</dd></div>
        </dl>
        <div class="mt-4 grid gap-2">
          <a href="/series/" class={`${buttonVariants({ variant: 'outline' })} justify-between`}>시리즈 탐색 <ArrowUpRight className="size-4" /></a>
        </div>
      </aside>
    </section>

    <section class="mt-24">
      <div class="mb-7 flex items-end justify-between gap-4">
        <div>
          <p class="mb-2 text-xs font-medium tracking-widest text-muted-foreground">BROWSE BY TOPIC</p>
          <h2 class="text-2xl font-semibold tracking-tight">주제별로 찾아보기</h2>
          <p class="mt-2 text-sm text-muted-foreground">관심 있는 분야부터 필요한 기록을 골라보세요.</p>
        </div>
        <a href="/category/" class={buttonVariants({ variant: 'ghost', size: 'sm' })}>전체 주제 <ArrowRight className="size-4" /></a>
      </div>
      <div class="grid overflow-hidden rounded-xl border sm:grid-cols-2 lg:grid-cols-3">
        {content.categories.map((category, index) => (
          <a href={`/category/${category.id}/`} class={`group flex min-h-44 flex-col justify-between bg-card p-6 transition-colors hover:bg-accent/50 ${index ? 'border-t sm:border-l' : ''} ${index === 2 ? 'sm:border-l-0 lg:border-l' : ''} ${index > 2 ? 'lg:border-t' : ''}`}>
            <div>
              <div class="flex items-start justify-between gap-4">
                <span class="text-xs text-muted-foreground tabular-nums">{String(index + 1).padStart(2, '0')}</span>
                <ArrowUpRight className="size-4 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
              </div>
              <h3 class="mt-5 text-lg font-semibold">{category.name}</h3>
              <p class="mt-2 line-clamp-2 text-sm leading-6 text-muted-foreground">{category.series.slice(0, 4).join(' · ')}</p>
            </div>
            <span class="mt-6 text-xs text-muted-foreground">{category.posts.length}개의 글</span>
          </a>
        ))}
        <a href="/tags/" class="group flex min-h-44 flex-col justify-between border-t bg-primary p-6 text-primary-foreground sm:border-l lg:border-t">
          <div class="flex items-start justify-between gap-4"><Tags className="size-5" /><ArrowUpRight className="size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" /></div>
          <div><h3 class="text-lg font-semibold">키워드로 찾기</h3><p class="mt-2 text-sm opacity-70">서로 다른 주제의 글을 태그로 연결합니다.</p></div>
        </a>
      </div>
    </section>

    <section class="mt-24">
      <div class="mb-7 flex items-end justify-between gap-4">
        <div>
          <p class="mb-2 text-xs font-medium tracking-widest text-muted-foreground">READ IN ORDER</p>
          <h2 class="text-2xl font-semibold tracking-tight">시리즈로 이어 읽기</h2>
          <p class="mt-2 text-sm text-muted-foreground">한 주제를 순서대로 따라가며 정리한 기록입니다.</p>
        </div>
        <a href="/series/" class={buttonVariants({ variant: 'ghost', size: 'sm' })}>모든 시리즈 <ArrowRight className="size-4" /></a>
      </div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {featuredSeries.map((series, index) => (
          <a href={seriesUrl(series.data.slug)} class="group flex min-h-56 flex-col rounded-xl border bg-card p-6 shadow-xs transition-[background-color,transform] hover:-translate-y-1 hover:bg-accent/40">
            <div class="flex items-center justify-between gap-3">
              <Library className="size-5 text-muted-foreground" />
              <span class="text-xs text-muted-foreground tabular-nums">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <div class="mt-auto pt-10">
              <h3 class="text-lg font-semibold leading-7">{series.data.name}</h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">{series.data.description || `${series.data.name}에 관한 글을 순서대로 읽어보세요.`}</p>
              <div class="mt-5 flex items-center justify-between text-xs text-muted-foreground"><span>{series.posts.length}개의 글</span><ArrowRight className="size-4 transition-transform group-hover:translate-x-1" /></div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-24 grid gap-8 rounded-xl border bg-muted/20 p-6 sm:p-8 lg:grid-cols-[18rem_minmax(0,1fr)] lg:p-10">
      <div>
        <p class="text-xs font-medium tracking-widest text-muted-foreground">KEYWORDS</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight">많이 다룬 키워드</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">작성한 글의 수를 기준으로 자주 등장한 주제를 모았습니다.</p>
      </div>
      <div class="flex content-start flex-wrap gap-2">
        {popularTags.map(tag => <a href={tagUrl(tag.name)}><Badge variant="outline" className="bg-background px-3 py-1.5 text-sm hover:bg-accent">#{tag.name} <span class="ml-1 text-muted-foreground">{tag.posts.length}</span></Badge></a>)}
      </div>
    </section>

  </div>
</BaseLayout>
