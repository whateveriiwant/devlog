---
import { badgeVariants } from '../../components/ui/badge';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getContent, seriesUrl } from '../../lib/content';
export async function getStaticPaths() { const {categories} = await getContent(); return categories.map(category => ({params:{slug:category.id}, props:{category}})); }
const { category } = Astro.props;
const { series } = await getContent();
const groups = series.filter(s => category.series.includes(s.data.name));
---
<BaseLayout title={category.name} category={category.id}>
  <header class="page-heading"><a href="/category/" class="eyebrow block">TOPICS / 주제</a><h1>{category.name}</h1><p class="page-description">{category.posts.length}개의 글 · {groups.length}개의 시리즈</p></header>
  <nav class="mb-6 flex flex-wrap gap-2" aria-label="이 주제의 시리즈">{groups.map(s => <a href={seriesUrl(s.data.slug)} class={badgeVariants({variant:"secondary"})}>{s.data.name}<span class="count">{s.posts.length}</span></a>)}</nav>
  <PostList posts={category.posts}/>
  <div slot="right"><h2 class="rail-heading mb-5">시리즈로 읽기</h2><div class="space-y-4">{groups.map(s => <a href={seriesUrl(s.data.slug)} class="subtle-link block">{s.data.name} <span class="count">{s.posts.length}</span></a>)}</div></div>
</BaseLayout>
