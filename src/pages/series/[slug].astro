---
import { Badge } from '../../components/ui/badge';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getContent } from '../../lib/content';
export async function getStaticPaths() {
  const { series } = await getContent();
  return series.map((group) => ({
    params: { slug: group.data.slug },
    props: { group },
  }));
}
const { group } = Astro.props;
---

<BaseLayout
  title={group.data.name}
  seriesId={group.id}
  description={
    group.data.description ||
    `${group.data.name}에 관한 ${group.posts.length}개의 글을 이어 읽습니다.`
  }
>
  <header class="page-heading">
    <a href="/series/" class="eyebrow block">
      시리즈
    </a>
    <h1>{group.data.name}</h1>
    {group.data.description && (
      <p class="page-description">{group.data.description}</p>
    )}
    <div class="stat-line">
      <Badge variant="secondary">{group.posts.length}개의 글</Badge>
    </div>
  </header>
  <div class="mb-5 flex justify-end">
    <div class="inline-flex h-9 items-center rounded-lg bg-muted p-1" aria-label="글 정렬 방식" data-series-sort>
      <button type="button" class="h-7 rounded-md bg-background px-3 text-xs font-medium text-foreground shadow-xs transition-[background-color,color,box-shadow]" data-sort="order" aria-pressed="true">시리즈 순서</button>
      <button type="button" class="h-7 rounded-md px-3 text-xs font-medium text-muted-foreground transition-[background-color,color,box-shadow] hover:text-foreground" data-sort="latest" aria-pressed="false">최신순</button>
    </div>
  </div>
  <div data-series-posts><PostList posts={group.posts} numbered /></div>
</BaseLayout>
<script>
  const sortRoot = document.querySelector<HTMLElement>('[data-series-sort]');
  const postList = document.querySelector<HTMLOListElement>('[data-series-posts] [data-post-list]');
  if (sortRoot && postList) {
    const buttons = Array.from(sortRoot.querySelectorAll<HTMLButtonElement>('[data-sort]'));
    const posts = Array.from(postList.children) as HTMLLIElement[];
    const setSort = (mode: string) => {
      const sorted = mode === 'latest'
        ? [...posts].sort((a, b) => Number(new Date(b.dataset.publishedAt || '')) - Number(new Date(a.dataset.publishedAt || '')))
        : posts;
      sorted.forEach((post, index) => {
        postList.append(post);
        const indexLabel = post.querySelector<HTMLElement>('.post-row-index');
        if (indexLabel) indexLabel.textContent = String(index + 1).padStart(2, '0');
      });
      buttons.forEach((button) => {
        const active = button.dataset.sort === mode;
        button.setAttribute('aria-pressed', String(active));
        button.classList.toggle('bg-background', active);
        button.classList.toggle('text-foreground', active);
        button.classList.toggle('text-muted-foreground', !active);
        button.classList.toggle('shadow-xs', active);
      });
    };
    buttons.forEach((button) => button.addEventListener('click', () => setSort(button.dataset.sort || 'order')));
  }
</script>
