---
import { Badge } from '../../components/ui/badge';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getContent } from '../../lib/content';
export async function getStaticPaths() {
  const { series } = await getContent();
  return series.map((group) => ({
    params: { slug: group.data.slug },
    props: { group },
  }));
}
const { group } = Astro.props;
---

<BaseLayout
  title={group.data.name}
  seriesId={group.id}
  description={
    group.data.description ||
    `${group.data.name}에 관한 ${group.posts.length}개의 글을 이어 읽습니다.`
  }
>
  <header class="page-heading">
    <a href="/series/" class="eyebrow block">
      시리즈
    </a>
    <h1>{group.data.name}</h1>
    {group.data.description && (
      <p class="page-description">{group.data.description}</p>
    )}
    <div class="stat-line">
      <Badge variant="secondary">{group.posts.length}개의 글</Badge>
    </div>
  </header>
  <PostList posts={group.posts} numbered />
</BaseLayout>
