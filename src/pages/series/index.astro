---
import CollectionRows from '../../components/CollectionRows';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContent, seriesUrl } from '../../lib/content';
const { series } = await getContent();
const sortedSeries = [...series].sort(
  (a, b) => b.posts.length - a.posts.length
);
---

<BaseLayout
  title="시리즈"
  description="기술 주제와 학습 과정, 활동별로 이어 읽는 기록입니다."
>
  <header class="page-heading">
    <p class="eyebrow">CONNECTED NOTES</p>
    <h1>시리즈</h1>
    <p class="page-description">
      하나의 주제를 따라 이어 읽는 {series.length}개의 묶음.
    </p>
  </header>
  <CollectionRows
    heading={3}
    rows={sortedSeries.map((s) => ({
      href: seriesUrl(s.data.slug),
      title: s.data.name,
      description: s.posts[0]?.data.title ?? '',
      count: s.posts.length,
    }))}
  />
  <div slot="right">
    <h2 class="rail-heading mb-5">시리즈 안내</h2>
    <p class="rail-note">
      관련 글을 하나의 흐름으로 묶어 순서대로 읽을 수 있습니다.
    </p>
  </div>
</BaseLayout>
