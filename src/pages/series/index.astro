---
import CollectionRows from '../../components/CollectionRows';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContent, seriesUrl } from '../../lib/content';
const { series } = await getContent();
const sortedSeries = [...series].sort(
  (a, b) => b.posts.length - a.posts.length
);
---

<BaseLayout
  title="시리즈"
  description="기술 주제와 학습 과정, 활동별로 이어 읽는 기록입니다."
>
  <header class="page-heading">
    <h1>시리즈</h1>
    <p class="page-description">
      하나의 주제를 따라 읽어보세요
    </p>
  </header>
  <CollectionRows
    heading={3}
    rows={sortedSeries.map((s) => ({
      href: seriesUrl(s.data.slug),
      title: s.data.name,
      description: s.posts[0]?.data.title ?? '',
      count: s.posts.length,
    }))}
  />
</BaseLayout>
