---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import BlogListHeader from '../../components/BlogListHeader.astro';
import { getContent } from '../../lib/content';
const { posts } = await getContent();
---

<BaseLayout
  title="개발 글 모음"
  description="JavaScript, React, 웹 개발과 컴퓨터공학에 관한 정승준의 개발 기록을 최신순으로 읽어보세요."
>
  <BlogListHeader count={posts.length} />
  <div
    data-d1-collection="posts"
    data-blog-metadata
    class="[&_[data-post-series]]:bg-transparent [&_[data-post-series]]:p-0 [&_[data-post-series]]:border-0"
  >
    <PostList posts={posts} blogMetadata />
  </div>
</BaseLayout>
