<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>글쓰기 로그인 · devlog</title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: system-ui, sans-serif;
        color: #222;
        background: #fafafa;
      }
      main {
        width: min(90vw, 400px);
        padding: 2rem;
        background: white;
        border: 1px solid #eee;
        border-radius: 12px;
        text-align: center;
      }
      button {
        padding: 0.8rem 1.3rem;
        border: 0;
        border-radius: 6px;
        background: #212121;
        color: white;
        font: inherit;
        cursor: pointer;
      }
      p {
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>devlog 글쓰기</h1>
      <p>GitHub 계정으로 로그인해야 편집기에 접근할 수 있습니다.</p>
      <button id="login" type="button">
        GitHub 로그인
      </button>
      <p id="status" role="status"></p>
    </main>
    <script>
      sessionStorage.removeItem('devlog-editor-token');
      const button = document.querySelector<HTMLButtonElement>('#login')!;
      const status = document.querySelector<HTMLElement>('#status')!;
      const reason = new URLSearchParams(location.search).get('error');
      if (reason) {
        status.textContent = reason === 'revoke'
          ? '기존 GitHub 권한을 정리하지 못했습니다. 다시 시도해 주세요.'
          : 'GitHub 로그인에 실패했습니다. 다시 시도해 주세요.';
      }
      const requestedNext = new URLSearchParams(location.search).get('next');
      const nextPath = requestedNext === '/admin/' || requestedNext === '/admin'
        ? '/admin/'
        : '/write/';
      button.addEventListener('click', () => {
        button.disabled = true;
        window.location.assign(
          `/api/auth/start?next=${encodeURIComponent(nextPath)}`
        );
      });
    </script>
  </body>
</html>
