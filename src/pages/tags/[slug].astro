---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getContent, tagUrl, tagSlug } from '../../lib/content';
export async function getStaticPaths() {
  const { tags } = await getContent();
  return tags.map((tag) => ({
    params: { slug: tagSlug(tag.name) },
    props: { tag },
  }));
}
const { tag } = Astro.props;
const { tags } = await getContent();
---

<BaseLayout title={`#${tag.name}`}>
  <header class="page-heading">
    <a href="/tags/" class="eyebrow block">
      태그
    </a>
    <h1>#{tag.name}</h1>
    <p class="page-description">{tag.posts.length}개의 글</p>
  </header>
  <PostList posts={tag.posts} />
</BaseLayout>
