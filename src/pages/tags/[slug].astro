---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getContent, tagUrl, tagSlug } from '../../lib/content';
export async function getStaticPaths() {
  const { tags } = await getContent();
  return tags.map((tag) => ({
    params: { slug: tagSlug(tag.name) },
    props: { tag },
  }));
}
const { tag } = Astro.props;
const { tags } = await getContent();
---

<BaseLayout title={`#${tag.name}`}>
  <header class="page-heading">
    <a href="/tags/" class="eyebrow block">
      TAGS / 키워드
    </a>
    <h1>#{tag.name}</h1>
    <p class="page-description">{tag.posts.length}개의 글</p>
  </header>
  <PostList posts={tag.posts} />
  <div slot="right">
    <h2 class="rail-heading mb-5">자주 다룬 키워드</h2>
    <div class="space-y-4">
      {tags.slice(0, 8).map((t) => (
        <a href={tagUrl(t.name)} class="subtle-link block">
          #{t.name} <span class="count">{t.posts.length}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
