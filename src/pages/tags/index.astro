---
import { Badge } from '../../components/ui/badge';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContent, tagUrl } from '../../lib/content';
const { tags } = await getContent();
---

<BaseLayout title="태그" description="기술과 키워드로 관련 글을 찾아보세요.">
  <header class="page-heading">
    <h1>태그</h1>
  </header>
  <div class="tag-index">
    {tags.map((t) => (
      <a href={tagUrl(t.name)}>
        <Badge variant="secondary">#{t.name}</Badge>
        <Badge variant="outline">{t.posts.length}</Badge>
      </a>
    ))}
  </div>
</BaseLayout>
