---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogListHeader from '../components/BlogListHeader.astro';
---

<BaseLayout
  title="글"
  description="모든 개발 기록을 모아둔 글 페이지입니다."
  noindex
>
  <link slot="head" rel="canonical" data-list-canonical href="/blog/" />
  <BlogListHeader />
  <div
    data-d1-collection="posts"
    data-blog-metadata
    class="[&_[data-post-series]]:bg-transparent [&_[data-post-series]]:p-0 [&_[data-post-series]]:border-0"
  ></div>
</BaseLayout>
