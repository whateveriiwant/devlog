---
import type { MarkdownHeading } from 'astro';
interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
const minimum = Math.min(...headings.map((h) => h.depth));
---

{headings.length > 0 && (
  <nav aria-label="이 글의 목차">
    <ol class="toc-list">
      {headings.map((h) => (
        <li style={`--depth:${h.depth - minimum}`}>
          <a href={`#${encodeURIComponent(h.slug)}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
